---
import PageHeader from '../../components/PageHeader.astro';
import ResearchList from '../../components/ResearchList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getResearch } from '../../utils/content';

const projects = await getResearch();
---

<BaseLayout title="Research" description="Research projects and areas of work.">
	<PageHeader
		label="Research"
		title="Projects and questions I'm working on."
		intro="Each project has its own page with the question, the data, the approach and what came out of it."
	/>
	<section class="container research" aria-label="Projects">
		<ResearchList projects={projects} headingLevel="h2" />
	</section>
</BaseLayout>

<style>
	.research {
		padding-bottom: clamp(4rem, 10vw, 8rem);
	}
</style>
