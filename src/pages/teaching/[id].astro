---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import SectionHead from '../../components/SectionHead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTeaching, type TeachingEntry } from '../../utils/content';
import { withBase } from '../../utils/url';

export const getStaticPaths = (async () => {
	const courses = await getTeaching();
	return courses.map((course) => ({ params: { id: course.id }, props: { course } }));
}) satisfies GetStaticPaths;

interface Props {
	course: TeachingEntry;
}

const { course } = Astro.props;
const { title, code, institution, role, terms, level, materials } = course.data;
const { Content } = await render(course);
const fullTitle = code ? `${code}: ${title}` : title;
const description =
	materials.length > 0
		? `Overview and course materials for ${fullTitle}, ${institution}.`
		: `Overview of ${fullTitle}, ${institution}.`;
const isExternal = (href: string): boolean => /^[a-z][a-z\d+.-]*:/i.test(href);
---

<BaseLayout title={fullTitle} description={description}>
	<article>
		<header
			class:list={['course-page__header container grid', { 'course-page__header--last': materials.length === 0 }]}
			data-hero
		>
			<a class="course-page__back label muted arrow-link" href={withBase('/teaching/')} data-reveal>
				<span aria-hidden="true">←</span> Teaching
			</a>
			<h1 class="course-page__title" data-split>{title}</h1>
			<div class="course-page__summary prose" data-reveal>
				<Content />
			</div>
			<dl class="course-page__facts label" data-reveal>
				{
					code && (
						<div>
							<dt class="muted">Course</dt>
							<dd>{code}</dd>
						</div>
					)
				}
				<div>
					<dt class="muted">Role</dt>
					<dd>{role}</dd>
				</div>
				{
					terms.length > 0 && (
						<div>
							<dt class="muted">{terms.length > 1 ? 'Terms' : 'Term'}</dt>
							<dd>{terms.join(', ')}</dd>
						</div>
					)
				}
				{
					level && (
						<div>
							<dt class="muted">Level</dt>
							<dd>{level}</dd>
						</div>
					)
				}
				<div class="course-page__where">
					<dt class="muted">Where</dt>
					<dd>{institution}</dd>
				</div>
			</dl>
		</header>

		{
			materials.length > 0 && (
				<section class="materials container" aria-labelledby="materials-title">
					<SectionHead index="01" title="Course materials" id="materials-title" />
					<ul class="materials__list" role="list">
						{
							materials.map((material) => (
								<li class="material grid">
									<span class="rule material__rule" data-line aria-hidden="true" />
									<span class="material__module label muted">{material.module}</span>
									<div class="material__main">
										<h3 class="material__title">
											<a class="material__link" href={withBase(material.href)} data-astro-reload>
												{material.title}
											</a>
										</h3>
										{material.description && (
											<p class="material__desc muted" data-reveal>
												{material.description}
											</p>
										)}
									</div>
									<span class="material__kind label muted">{material.kind}</span>
									<span class="material__arrow" aria-hidden="true">
										{isExternal(material.href) ? '↗' : '→'}
									</span>
								</li>
							))
						}
					</ul>
				</section>
			)
		}
	</article>
</BaseLayout>

<style>
	.course-page__header {
		row-gap: 1.5rem;
		padding-top: clamp(3rem, 8vw, 7rem);
		padding-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	/* Without a materials section, the header is the whole page. */
	.course-page__header--last {
		padding-bottom: clamp(4rem, 10vw, 8rem);
	}

	.course-page__back {
		grid-column: 1 / span 3;
		align-self: start;
		padding-top: 0.9rem;
	}

	.course-page__back:hover {
		color: var(--ink);
	}

	.course-page__title {
		grid-column: 4 / -1;
		font-size: var(--fs-h1);
	}

	.course-page__summary {
		grid-column: 4 / span 6;
		color: var(--muted);
	}

	.course-page__facts {
		grid-column: 4 / -1;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem clamp(1.5rem, 4vw, 3.5rem);
	}

	.course-page__facts dd {
		margin-top: 0.3rem;
	}

	/* The institution reads better in normal case than in the uppercase label style. */
	.course-page__where {
		flex-basis: 100%;
	}

	.course-page__where dd {
		font-family: var(--font-sans);
		font-size: var(--fs-small);
		letter-spacing: 0;
		text-transform: none;
	}

	.materials {
		padding-top: clamp(2rem, 5vw, 4rem);
		padding-bottom: clamp(4rem, 10vw, 8rem);
	}

	.materials__list {
		padding: 0;
		list-style: none;
	}

	.material {
		position: relative;
		align-items: start;
		row-gap: 0.5rem;
	}

	.material:last-child {
		border-bottom: 1px solid var(--line);
	}

	.material__rule {
		grid-column: 1 / -1;
		margin-bottom: clamp(1.25rem, 2.4vw, 2rem);
	}

	.material__module {
		grid-column: 1 / span 3;
		padding-top: 0.45rem;
	}

	.material__main {
		grid-column: 4 / span 6;
		display: grid;
		gap: 0.6rem;
		padding-bottom: clamp(1.25rem, 2.4vw, 2rem);
	}

	.material__title {
		font-size: var(--fs-h3);
		letter-spacing: -0.02em;
		line-height: 1.15;
		transition: color 0.35s var(--ease-out);
	}

	/* The whole row opens the lab; z-index keeps the overlay above the revealed description. */
	.material__link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.material__link:focus-visible {
		outline: none;
	}

	.material:has(.material__link:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}

	.material__desc {
		max-width: 56ch;
		font-size: var(--fs-small);
	}

	.material__kind {
		grid-column: 10 / span 2;
		padding-top: 0.45rem;
	}

	.material__arrow {
		grid-column: 12;
		justify-self: end;
		font-size: var(--fs-h3);
		line-height: 1.15;
		transition: transform 0.45s var(--ease-out);
	}

	.material:hover .material__title {
		color: var(--accent);
	}

	.material:hover .material__arrow {
		transform: translateX(6px);
	}

	@media (max-width: 760px) {
		.course-page__back,
		.course-page__title,
		.course-page__summary,
		.course-page__facts {
			grid-column: 1 / -1;
		}

		.material__module {
			grid-column: 1 / span 9;
			padding-top: 0;
		}

		.material__main {
			grid-column: 1 / span 11;
			padding-bottom: 0;
		}

		.material__kind {
			grid-column: 1 / -1;
			padding-top: 0;
			padding-bottom: 1.25rem;
		}

		.material__arrow {
			grid-column: 12;
			grid-row: 2 / span 2;
		}
	}
</style>
