---
import PageHeader from '../components/PageHeader.astro';
import PublicationItem from '../components/PublicationItem.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { externalLinks } from '../site.config';
import { getPublications } from '../utils/content';
import { groupByYear } from '../utils/list';

const publications = await getPublications();
const underReview = publications.filter((p) => p.data.type === 'manuscript');
const published = publications.filter((p) => p.data.type !== 'manuscript');
const groups = [
	...(underReview.length > 0 ? [{ id: 'under-review', label: 'Under review', items: underReview }] : []),
	...groupByYear(published).map((group) => ({ id: `year-${group.year}`, label: String(group.year), items: group.items })),
];
const scholar = externalLinks.find((link) => link.label === 'Google Scholar');
---

<BaseLayout title="Publications" description="Journal articles, proceedings papers, abstracts and manuscripts under review.">
	<PageHeader
		label="Publications"
		title="Publications"
		intro="Journal articles, proceedings papers, meeting abstracts and preprints, newest first, with manuscripts under review at the top."
	>
		{
			scholar && (
				<a class="scholar label arrow-link" href={scholar.href} data-reveal>
					Google Scholar profile <span aria-hidden="true">↗</span>
				</a>
			)
		}
	</PageHeader>

	<div class="container years">
		{
			groups.map((group) => (
				<section class="year grid" aria-labelledby={group.id}>
					<h2 class="year__label label" id={group.id}>
						{group.label}
					</h2>
					<ul class="year__list" role="list">
						{group.items.map((publication) => (
							<PublicationItem publication={publication} showYear={false} />
						))}
					</ul>
				</section>
			))
		}
	</div>
</BaseLayout>

<style>
	.scholar {
		grid-column: 4 / -1;
	}

	.years {
		padding-bottom: clamp(4rem, 10vw, 8rem);
	}

	.year {
		align-items: start;
	}

	.year + .year {
		margin-top: clamp(1.5rem, 3vw, 2.5rem);
	}

	.year__label {
		position: sticky;
		top: calc(var(--header-h) + 1rem);
		grid-column: 1 / span 3;
		padding-top: 1.35rem;
		font-size: 0.875rem;
	}

	.year__list {
		grid-column: 4 / -1;
		padding: 0;
		list-style: none;
	}

	/* Inside a year group the entries sit in the right-hand nine columns. */
	.year__list :global(.pub) {
		grid-template-columns: repeat(9, minmax(0, 1fr));
	}

	.year__list :global(.pub__body) {
		grid-column: 1 / span 7;
	}

	.year__list :global(.pub__link) {
		grid-column: 8 / -1;
	}

	@media (max-width: 760px) {
		.scholar {
			grid-column: 1 / -1;
		}

		.year__label {
			position: static;
			grid-column: 1 / -1;
			padding-top: 0;
			padding-bottom: 0.75rem;
		}

		.year__list {
			grid-column: 1 / -1;
		}
	}
</style>
