---
import { MARK_VIEWBOX, markPath } from '../utils/mark';

interface Props {
	size?: number;
	class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<svg
	class:list={['mark', className]}
	width={size}
	height={size}
	viewBox={MARK_VIEWBOX}
	aria-hidden="true"
	focusable="false"
>
	<path d={markPath} fill="currentColor"></path>
</svg>
