---
import { render } from 'astro:content';
import type { TeachingEntry } from '../utils/content';
import { withBase } from '../utils/url';

interface Props {
	courses: readonly TeachingEntry[];
	/** Render each course's Markdown description. */
	withDescription?: boolean;
	/** Heading level of each course title, so the page outline stays correct. */
	headingLevel?: 'h2' | 'h3';
}

const { courses, withDescription = false, headingLevel: Heading = 'h3' } = Astro.props;
const rendered = await Promise.all(
	courses.map(async (course) => ({ course, Content: withDescription ? (await render(course)).Content : null })),
);
---

<ul class="courses" role="list">
	{
		rendered.map(({ course, Content }) => (
			<li class="course grid">
				<span class="rule course__rule" data-line aria-hidden="true" />
				<span class="course__code label muted">{course.data.code ?? course.data.level}</span>
				{/* No data-reveal around the link: a transformed ancestor would shrink the row-wide overlay to its own box. */}
				<div class="course__body">
					<Heading class="course__title">
						<a class="course__link" href={withBase(`/teaching/${course.id}/`)}>
							{course.data.title}
						</a>
					</Heading>
					<p class="course__meta muted" data-reveal>
						{course.data.role} · {course.data.institution}
						{course.data.level && course.data.code && ` · ${course.data.level}`}
					</p>
					{Content && (
						<div class="course__desc prose" data-reveal>
							<Content />
						</div>
					)}
				</div>
				<span class="course__terms label muted">{course.data.terms.join(', ')}</span>
				<span class="course__arrow" aria-hidden="true">
					→
				</span>
			</li>
		))
	}
</ul>

<style>
	.courses {
		padding: 0;
		list-style: none;
	}

	.course {
		position: relative;
		align-items: start;
	}

	.course__rule {
		grid-column: 1 / -1;
		margin-bottom: clamp(1.1rem, 2vw, 1.6rem);
	}

	.course__code {
		grid-column: 1 / span 3;
		padding-top: 0.4rem;
	}

	.course__body {
		grid-column: 4 / span 6;
		display: grid;
		gap: 0.4rem;
		padding-bottom: clamp(1.1rem, 2vw, 1.6rem);
	}

	.course__title {
		font-size: var(--fs-h3);
		letter-spacing: -0.02em;
		line-height: 1.15;
		transition: color 0.35s var(--ease-out);
	}

	/*
	 * The whole row opens the course page, but the link's name is just the
	 * title. z-index keeps the overlay above the revealed meta line, whose
	 * leftover transform would otherwise paint over it and swallow clicks.
	 */
	.course__link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.course__link:focus-visible {
		outline: none;
	}

	.course:has(.course__link:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}

	.course__meta {
		font-size: var(--fs-small);
	}

	/*
	 * A link written into a course description must sit above the overlay.
	 * The reveal leaves a transform on .course__desc, which traps any z-index
	 * inside it, so the whole description is lifted and lets clicks on plain
	 * text fall through to the overlay below.
	 */
	.course__desc {
		position: relative;
		z-index: 2;
		margin-top: 0.5rem;
		font-size: var(--fs-small);
		pointer-events: none;
	}

	.course__desc :global(a) {
		pointer-events: auto;
	}

	.course__terms {
		grid-column: 10 / span 2;
		padding-top: 0.4rem;
	}

	.course__arrow {
		grid-column: 12;
		justify-self: end;
		font-size: var(--fs-h3);
		line-height: 1.15;
		transition: transform 0.45s var(--ease-out);
	}

	.course:hover .course__title {
		color: var(--accent);
	}

	.course:hover .course__arrow {
		transform: translateX(6px);
	}

	@media (max-width: 760px) {
		.course__code,
		.course__terms {
			grid-column: 1 / -1;
		}

		.course__code {
			padding-bottom: 0.4rem;
		}

		.course__body {
			grid-column: 1 / span 11;
		}

		.course__terms {
			padding-top: 0;
			padding-bottom: 1.25rem;
		}

		/* Beside the title, which sits on the third row once the code has a row to itself. */
		.course__arrow {
			grid-column: 12;
			grid-row: 3;
		}
	}
</style>
